{
  "name": "deutschland-bilanz",
  "version": "2.2.0",
  "description": "Die Bilanz der Republik — Haushaltsbuch über Ausgaben, Steuern, Schulden, Soziales und Energie Deutschlands",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"src/**/*.css\" \"*.html\"",
    "test:unit": "jest --coverage --verbose",
    "test:a11y": "axe-cli http://localhost:4173/",
    "test:performance": "lhci autorun --config .lighthouserc.json",
    "test:all": "npm run lint && npm run format -- --check && npm run test:unit && npm run test:a11y && npm run test:performance",
    "data:validate": "node scripts/validateData.js --strict",
    "data:fetch": "node scripts/fetchData.js",
    "deploy": "gh-pages -d dist",
    "deploy:preview": "gh-pages -d dist --branch gh-pages"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "jest": "^29.7.0",
    "axe-core": "^4.10.0",
    "@axe-core/puppeteer": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "gh-pages": "^6.2.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/USERNAME/deutschland-bilanz.git"
  },
  "homepage": "https://USERNAME.github.io/deutschland-bilanz/",
  "keywords": ["germany", "budget", "fiscal", "politics", "data", "transparency", "pwa"],
  "author": "Die Bilanz der Republik Contributors",
  "license": "CC-BY-4.0"
}
